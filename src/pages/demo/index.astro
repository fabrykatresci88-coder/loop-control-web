---
const title = 'Demo aplikacji | Loop Control OS';
---
<!doctype html><html lang="pl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,follow"/><meta name="theme-color" content="#020617"/><title>{title}</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e2e8f0;background:#0f172a}*{box-sizing:border-box}body{margin:0}button,input{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #60a5fa;outline-offset:3px}a{color:inherit}.app{display:flex;min-height:100dvh}.side{width:246px;flex-shrink:0;background:#1e293b;border-right:1px solid #334155;padding:18px 12px;display:flex;flex-direction:column;gap:12px}.brand{display:flex;align-items:center;gap:11px;padding:8px 10px 22px;border-bottom:1px solid #334155}.brandicon{background:linear-gradient(140deg,#3b82f6,#1d4ed8);border-radius:10px;padding:11px;color:white;font-weight:900}.brand strong{display:block;font-size:14px;color:white}.brand small{color:#94a3b8}.group{font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:#64748b;padding:15px 12px 4px;font-weight:800}.navbtn{border:0;background:none;color:#cbd5e1;text-align:left;border-radius:9px;padding:12px;display:flex;align-items:center;gap:12px;width:100%}.navbtn:hover{background:#334155}.navbtn.active{background:#1d4ed8;color:white}.navbtn span:first-child{font-size:18px;width:22px;text-align:center}.sidebottom{margin-top:auto;padding:15px 10px;color:#94a3b8;font-size:12px;border-top:1px solid #334155}.main{flex:1;min-width:0}.top{height:69px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid #334155;padding:0 26px;background:#111c30}.top strong{color:#f8fafc}.topright{display:flex;align-items:center;gap:12px;font-size:12px;color:#94a3b8}.pill{border:1px solid #475569;border-radius:999px;padding:7px 10px;color:#93c5fd;font-size:11px}.back{color:#93c5fd;text-decoration:none}.body{padding:28px;max-width:1460px;margin:auto}.intro{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:25px}.intro h1{font-size:27px;color:white;letter-spacing:-.04em;margin:0 0 7px}.intro p{margin:0;color:#94a3b8;font-size:13px}.btn{border:1px solid #475569;border-radius:8px;padding:10px 14px;background:#1e293b;color:#e2e8f0}.btn.primary{background:#2563eb;border-color:#2563eb;color:white}.btn:hover{filter:brightness(1.17)}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:22px}.kpi{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:19px}.kpi small{color:#94a3b8}.kpi b{display:block;font-size:28px;margin:12px 0 5px;color:white}.kpi em{font-size:11px;font-style:normal;color:#64748b}.layout{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}.panel{background:#1e293b;border:1px solid #334155;border-radius:12px;overflow:hidden}.panelhead{padding:18px 20px;border-bottom:1px solid #334155;display:flex;justify-content:space-between;align-items:center;gap:10px}.panelhead h2{font-size:15px;margin:0;color:white}.panelhead small{color:#94a3b8}.actions{padding:12px 16px;display:grid;gap:8px}.action{background:#0f172a;border:1px solid #334155;border-radius:9px;padding:12px;text-align:left;color:#e2e8f0;display:flex;justify-content:space-between;gap:10px}.action:hover{border-color:#60a5fa}.action small{color:#94a3b8}.activity{padding:12px 20px;display:grid;gap:18px}.activityrow{display:flex;gap:12px;font-size:13px;color:#cbd5e1}.activityrow i{height:9px;width:9px;border-radius:50%;background:#60a5fa;flex-shrink:0;margin-top:4px}.activityrow small{display:block;color:#64748b;margin-top:5px}.tablewrap{overflow-x:auto}.datatable{width:100%;border-collapse:collapse;min-width:580px;text-align:left}.datatable th,.datatable td{padding:15px 18px;border-bottom:1px solid #334155;font-size:13px}.datatable th{color:#94a3b8;font-size:11px}.datatable tr:last-child td{border:0}.tag{background:#164e63;color:#67e8f9;border-radius:99px;padding:5px 8px;font-size:11px}.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px}.toolbar input{background:#1e293b;color:#e2e8f0;border:1px solid #475569;border-radius:8px;padding:11px 13px;min-width:210px;max-width:100%}.kanban{display:flex;gap:12px;overflow-x:auto;padding-bottom:14px}.lane{background:#17243a;border:1px solid #334155;border-radius:11px;min-width:220px;flex:1;padding:13px}.lane h3{font-size:13px;color:#cbd5e1;margin:0 0 15px}.deal{background:#1e293b;border:1px solid #475569;border-radius:9px;padding:13px;margin-bottom:10px;font-size:13px}.deal strong{display:block;color:white;margin-bottom:10px}.deal small{color:#94a3b8}.note{color:#94a3b8;font-size:12px;margin:20px 0}.mobilemenu{display:none;background:#1e293b;border:1px solid #475569;border-radius:8px;color:white;padding:8px}.hidden{display:none!important}@media(max-width:1000px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}}@media(max-width:760px){.side{position:fixed;z-index:10;inset:0 auto 0 0;transform:translateX(-100%);transition:transform .2s;box-shadow:10px 0 35px #0005}.side.open{transform:none}.mobilemenu{display:block}.top{padding:0 15px}.topright .pill{display:none}.body{padding:18px}.intro{align-items:flex-start;flex-direction:column}.kpis{gap:9px}.kpi{padding:14px}.kpi b{font-size:23px}}@media(prefers-reduced-motion:reduce){.side{transition:none}}
</style></head><body><div class="app"><aside class="side" id="sidebar"><div class="brand"><div class="brandicon">⌘</div><div><strong>Loop Control</strong><small>AI Company OS · DEMO</small></div></div><div class="group">Główne</div><button class="navbtn active" data-page="dashboard"><span>▦</span>Panel główny</button><div class="group">Klienci</div><button class="navbtn" data-page="crm"><span>♙</span>CRM</button><button class="navbtn" data-page="leads"><span>⌕</span>Lead Intelligence</button><button class="navbtn" data-page="sales"><span>▥</span>Sales Pipeline</button><div class="group">AI Tools</div><button class="navbtn" data-page="analyzer"><span>✧</span>AI Analyzer</button><div class="group">Marketing</div><button class="navbtn" data-page="content"><span>✎</span>Content Engine</button><div class="sidebottom">● Demo offline · dane syntetyczne</div></aside><main class="main"><header class="top"><div style="display:flex;align-items:center;gap:12px"><button class="mobilemenu" id="menu" aria-label="Otwórz menu" aria-expanded="false">☰</button><strong id="pagetitle">Panel główny</strong></div><div class="topright"><span class="pill">Środowisko demonstracyjne</span><a class="back" href="/">← Wróć do strony</a></div></header><div class="body" id="workspace"><div class="intro"><div><h1>Panel główny</h1><p>Podgląd pracy Twojej firmy w jednym miejscu</p></div><button class="btn primary" data-action="new">+ Dodaj klienta</button></div><div class="kpis"><div class="kpi"><small>Wszyscy klienci</small><b>24</b><em>Aktywne kontakty</em></div><div class="kpi"><small>Otwarte leady</small><b>12</b><em>Oczekują na kontakt</em></div><div class="kpi"><small>Aktywne projekty</small><b>4</b><em>W realizacji</em></div><div class="kpi"><small>Otwarte zadania</small><b>9</b><em>Do wykonania</em></div></div><div class="layout"><section class="panel"><div class="panelhead"><h2>Szybkie akcje</h2><small>Najczęstsze działania</small></div><div class="actions"><button class="action" data-go="crm">Dodaj klienta <small>→</small></button><button class="action" data-go="leads">Sprawdź leady <small>→</small></button><button class="action" data-go="sales">Otwórz pipeline <small>→</small></button><button class="action" data-go="content">Przejdź do treści <small>→</small></button></div></section><section class="panel"><div class="panelhead"><h2>Ostatnia aktywność</h2><small>Ostatnie działania</small></div><div class="activity"><div class="activityrow"><i></i><div>Dodano kontakt Studio Nova<small>Dzisiaj · 10:45</small></div></div><div class="activityrow"><i></i><div>Zaktualizowano ofertę dla Atelier M<small>Wczoraj · 16:20</small></div></div><div class="activityrow"><i></i><div>Zaplanowano follow-up<small>Wczoraj · 09:10</small></div></div></div></section></div><p class="note">Demo odzwierciedla strukturę modułów Loop Control OS. Nie jest połączone z rzeczywistym kontem ani produkcyjnym API.</p></div></main></div>
<script is:inline>
(()=>{const area=document.getElementById('workspace'),title=document.getElementById('pagetitle'),side=document.getElementById('sidebar'),menu=document.getElementById('menu');const data={crm:{title:'CRM',desc:'Klienci, firmy, projekty i zadania',kpis:[['Klienci','24'],['Firmy','18'],['Otwarte leady','12'],['Zadania','9']],columns:['Firma','Kontakt','Status','Następne działanie'],rows:[['Studio Nova','Anna Nowak','Aktywny','Prezentacja'],['Atelier M','Kamil Lis','W rozmowie','Oferta'],['Pixel Works','Ola Zielińska','Nowy','Telefon']]},leads:{title:'Lead Intelligence',desc:'Przegląd potencjalnych klientów i kwalifikacji',kpis:[['Znalezione','36'],['Do analizy','8'],['Zakwalifikowane','14'],['Do kontaktu','6']],columns:['Firma','Branża','Ocena','Działanie'],rows:[['Green Lab','Usługi','82 / 100','Kontakt'],['Nova Service','B2B','74 / 100','Weryfikacja'],['Pracownia Forma','Design','68 / 100','Analiza']]},analyzer:{title:'AI Analyzer',desc:'Przykładowe wyniki analizy firm',kpis:[['Analizy','18'],['Wysoki potencjał','5'],['W kolejce','3'],['Raporty','12']],columns:['Firma','Potencjał','Priorytet','Status'],rows:[['Studio Nova','Wysoki','A','Przejrzano'],['Green Lab','Wysoki','A','Przejrzano'],['Pixel Works','Średni','B','Do oceny']]},content:{title:'Content Engine',desc:'Planowanie treści i działań marketingowych',kpis:[['Pomysły','18'],['Szkice','7'],['W planie','4'],['Kanały','3']],columns:['Temat','Kanał','Status','Kolejny krok'],rows:[['Poradnik CRM','Blog','Szkic','Redakcja'],['Nowa usługa','Facebook','Plan','Akceptacja'],['Case study','LinkedIn','Pomysł','Konspekt']]}};let current='dashboard';const initial=area.innerHTML;function esc(s){return String(s).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]))}function cards(items){return '<div class="kpis">'+items.map(([k,v])=>'<div class="kpi"><small>'+esc(k)+'</small><b>'+esc(v)+'</b><em>Dane demonstracyjne</em></div>').join('')+'</div>'}function table(d){return '<div class="panel"><div class="panelhead"><h2>Przegląd danych</h2><small>Przykładowe rekordy</small></div><div class="tablewrap"><table class="datatable"><thead><tr>'+d.columns.map(x=>'<th>'+esc(x)+'</th>').join('')+'</tr></thead><tbody>'+d.rows.map(row=>'<tr>'+row.map((x,i)=>'<td>'+(i===2?'<span class="tag">'+esc(x)+'</span>':esc(x))+'</td>').join('')+'</tr>').join('')+'</tbody></table></div></div>'}function render(page){current=page;document.querySelectorAll('.navbtn').forEach(b=>b.classList.toggle('active',b.dataset.page===page));side.classList.remove('open');menu.setAttribute('aria-expanded','false');if(page==='dashboard'){title.textContent='Panel główny';area.innerHTML=initial;return}if(page==='sales'){title.textContent='Sales Pipeline';const lanes=[['Nowe',[['Studio Nova','3 200 zł'],['Green Lab','2 100 zł']]],['Zakwalifikowane',[['Atelier M','5 400 zł']]],['W rozmowie',[['Pixel Works','4 800 zł']]],['Oferta',[['Nova Service','7 200 zł']]],['Wygrane',[['Pracownia Forma','3 600 zł']]]];area.innerHTML='<div class="intro"><div><h1>Sales Pipeline</h1><p>Szanse sprzedażowe według etapów · symulacja</p></div></div>'+cards([['Aktywne szanse','5'],['Wartość pipeline','22 700 zł'],['Wygrane','1'],['Konwersja','20%']])+'<div class="kanban">'+lanes.map(([name,deals])=>'<section class="lane"><h3>'+esc(name)+' · '+deals.length+'</h3>'+deals.map(([n,v])=>'<div class="deal"><strong>'+esc(n)+'</strong><small>'+esc(v)+'</small></div>').join('')+'</section>').join('')+'</div>';return}const d=data[page];if(!d)return;title.textContent=d.title;area.innerHTML='<div class="intro"><div><h1>'+esc(d.title)+'</h1><p>'+esc(d.desc)+'</p></div></div>'+cards(d.kpis)+'<div class="toolbar"><label for="search">Filtruj rekordy</label><input id="search" type="search" placeholder="Wpisz nazwę firmy…"/></div>'+table(d)+'<p class="note">Wszystkie dane są fikcyjne. Wyszukiwanie filtruje tylko widoczne rekordy.</p>';const search=document.getElementById('search');search.addEventListener('input',()=>{const q=search.value.toLocaleLowerCase('pl');area.querySelectorAll('tbody tr').forEach(row=>row.hidden=!row.textContent.toLocaleLowerCase('pl').includes(q))})}document.addEventListener('click',e=>{const nav=e.target.closest('[data-page]'),go=e.target.closest('[data-go]');if(nav)render(nav.dataset.page);if(go)render(go.dataset.go);if(e.target.closest('[data-action="new"]'))render('crm')});menu.addEventListener('click',()=>{side.classList.toggle('open');menu.setAttribute('aria-expanded',String(side.classList.contains('open')))});})();
</script></body></html>