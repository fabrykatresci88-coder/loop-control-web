---
const title = 'Loop Control OS — jedno centrum rozwoju Twojej firmy';
const description = 'Loop Control OS łączy CRM, zarządzanie leadami, sprzedaż i marketing w jednym miejscu. Poznaj platformę stworzoną z myślą o rozwijających się firmach.';
const modules = [
  { number:'01', tag:'Relacje', title:'CRM i klienci', description:'Kontakty, historia współpracy i zadania w jednym uporządkowanym widoku.', points:['Kartoteki firm i kontaktów','Historia działań','Zadania i kolejne kroki'] },
  { number:'02', tag:'Pozyskiwanie', title:'Leady i analiza', description:'Pracuj z potencjalnymi klientami i porządkuj informacje potrzebne do podjęcia decyzji.', points:['Baza potencjalnych klientów','Analiza i kwalifikacja','Priorytety kontaktu'] },
  { number:'03', tag:'Wyniki', title:'Sales Engine', description:'Prowadź szanse sprzedażowe od pierwszego kontaktu do kolejnego etapu rozmów.', points:['Pipeline sprzedażowy','Follow-upy i zadania','Widoczność postępów'] },
  { number:'04', tag:'Komunikacja', title:'Content Engine', description:'Planuj treści i organizuj działania marketingowe w spójnym środowisku.', points:['Planowanie komunikacji','Przestrzeń na treści','Organizacja kampanii'] },
];
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#07101e" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://loopcontrolos.pl/" />
  <link rel="canonical" href="https://loopcontrolos.pl/" />
  <title>{title}</title>
  <style>
    :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#eff7ff;background:#07101e;color-scheme:dark}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:radial-gradient(ellipse 75% 36% at 88% 5%,#143b51 0%,transparent 75%),#07101e}a{color:inherit}a:focus-visible{outline:3px solid #77e5e5;outline-offset:4px}.container{width:min(1160px,calc(100% - 48px));margin-inline:auto}
    .skip{position:absolute;left:-9999px;top:8px;padding:10px;background:#fff;color:#000;z-index:10}.skip:focus{left:12px}
    .topbar{border-bottom:1px solid #233347;background:#07101ec9}.nav{min-height:84px;display:flex;align-items:center;justify-content:space-between;gap:24px}.logo{font-size:1.05rem;font-weight:850;letter-spacing:-.045em;text-decoration:none;white-space:nowrap}.logo span{color:#75e5e5}.navlinks{display:flex;align-items:center;gap:28px}.navlinks a{font-size:.92rem;color:#c5d6e6;text-decoration:none}.navlinks a:hover{color:#7be9e8}.navlinks .navcta{border:1px solid #45677a;border-radius:10px;padding:12px 17px;color:#f4fbff}
    .hero{padding:clamp(82px,11vw,152px) 0 105px;display:grid;grid-template-columns:1.18fr .82fr;align-items:center;gap:50px}.eyebrow{display:inline-flex;align-items:center;gap:9px;border:1px solid #31596a;border-radius:100px;background:#102638;padding:9px 14px;color:#90eeee;font-size:.79rem;font-weight:750;letter-spacing:.02em}.eyebrow:before{content:"";height:7px;width:7px;border-radius:50%;background:#77e4d6;box-shadow:0 0 0 4px #77e4d622}h1{font-size:clamp(3rem,6.5vw,6rem);line-height:1.03;letter-spacing:-.067em;margin:27px 0 24px}h1 strong{font-weight:850;color:#75e5e5}.lead{max-width:630px;color:#b9cce0;line-height:1.8;font-size:clamp(1.05rem,1.6vw,1.22rem)}.actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:32px}.button{display:inline-flex;justify-content:center;align-items:center;min-height:50px;border-radius:11px;padding:13px 21px;font-weight:750;text-decoration:none;transition:transform .2s,background .2s}.button:hover{transform:translateY(-2px)}.button.primary{background:#76e5e4;color:#061827}.button.primary:hover{background:#a3f5f0}.button.secondary{border:1px solid #45627a;color:#edf8ff}.note{color:#829bb2;font-size:.82rem;margin-top:19px}
    .preview{border:1px solid #2b4b60;border-radius:22px;background:linear-gradient(155deg,#142d42,#0a1829);box-shadow:0 32px 90px #0005;overflow:hidden;transform:rotate(1deg)}.previewbar{height:44px;display:flex;align-items:center;gap:7px;border-bottom:1px solid #2b4355;padding:0 19px}.dot{height:8px;width:8px;border-radius:50%;background:#526e82}.previewbar small{margin-left:auto;color:#8ba7bd;font-size:.7rem}.dashboard{padding:26px}.dashlabel{color:#90adbf;font-size:.75rem;letter-spacing:.11em;text-transform:uppercase}.dashtitle{font-size:1.3rem;font-weight:800;margin:10px 0 24px}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.stat{border:1px solid #2d4a60;border-radius:12px;padding:17px;background:#0b1c2d}.stat small{color:#9ab1c7}.stat b{display:block;margin-top:12px;font-size:1.7rem;color:#dffaff}.stat:nth-child(2) b{color:#77e5e5}.bars{display:flex;align-items:end;gap:12px;height:115px;padding:20px 0 0}.bars span{flex:1;border-radius:6px 6px 0 0;background:linear-gradient(#7be7e3,#216178);height:var(--h)}.previewcaption{color:#8ca9bc;font-size:.76rem;margin-top:14px}
    section{scroll-margin-top:28px}.section{padding:85px 0}.sectiontop{max-width:760px;margin-bottom:34px}.kicker{color:#7de8e4;font-weight:800;font-size:.82rem;letter-spacing:.12em;text-transform:uppercase}.section h2{font-size:clamp(2rem,4.5vw,3.45rem);letter-spacing:-.055em;line-height:1.12;margin:15px 0}.sectionintro{color:#b5c7d9;line-height:1.75;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.module{border:1px solid #294157;background:linear-gradient(145deg,#13293e,#0a1728);padding:32px;border-radius:20px}.modulehead{display:flex;align-items:center;justify-content:space-between;color:#7de5e5;font-weight:750;font-size:.8rem}.modulehead span:last-child{color:#6e91a8;font-size:1rem}.module h3{font-size:1.65rem;letter-spacing:-.04em;margin:24px 0 10px}.module p{color:#b6c8d9;line-height:1.75;margin:0}.module ul{margin:23px 0 0;padding:20px 0 0;border-top:1px solid #294459;list-style:none;display:grid;gap:12px}.module li{color:#d9e9f5;font-size:.9rem}.module li:before{content:"✓";color:#7de5e5;font-weight:800;margin-right:11px}
    .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:36px}.benefit{border-top:1px solid #345168;padding-top:22px}.benefit b{display:block;font-size:1.15rem;margin-bottom:10px}.benefit p{color:#b0c5d7;line-height:1.7;margin:0}.cta{margin:65px auto 90px;padding:clamp(30px,6vw,68px);border:1px solid #366276;border-radius:24px;background:radial-gradient(circle at 90% 10%,#235769,transparent 55%),#10273a}.cta h2{max-width:700px;font-size:clamp(2rem,4.7vw,3.7rem);line-height:1.1;letter-spacing:-.05em;margin:15px 0}.cta p{color:#bcd1e0;line-height:1.7;max-width:650px}.footer{border-top:1px solid #263b4f;padding:32px 0;color:#94aabe;font-size:.85rem}.footerinner{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}.footer a{text-decoration:none;color:#b7d6e6}
    @media(max-width:950px){.hero{grid-template-columns:1fr;padding-top:80px}.preview{max-width:580px;transform:none}.navlinks{gap:14px}}
    @media(max-width:640px){.container{width:calc(100% - 32px)}.nav{min-height:72px}.navlinks a:not(.navcta){display:none}.navlinks .navcta{padding:10px 12px;font-size:.78rem}.logo{font-size:.9rem}.hero{padding:64px 0 60px;gap:34px}h1{font-size:clamp(2.7rem,12vw,4.4rem)}.grid,.benefits{grid-template-columns:1fr}.module{padding:24px}.section{padding:60px 0}.cta{margin:35px auto 65px}.stats{gap:8px}.dashboard{padding:18px}.stat{padding:13px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.button{transition:none}.button:hover{transform:none}}
.demo-shell{display:grid;grid-template-columns:225px minmax(0,1fr);border:1px solid #345369;border-radius:22px;overflow:hidden;background:#0b1929;box-shadow:0 28px 75px #0004}.demo-side{padding:25px 16px;background:#0e2235;border-right:1px solid #28465c;display:flex;flex-direction:column;gap:26px}.demo-brand{font-size:.82rem;font-weight:850;white-space:nowrap}.demo-brand span{color:#78e7e3}.demo-menu{display:grid;gap:8px}.demo-tab{font:inherit;text-align:left;color:#bcd1df;background:transparent;border:1px solid transparent;border-radius:10px;padding:13px 12px;cursor:pointer}.demo-tab:hover,.demo-tab:focus-visible{border-color:#48788a;color:#fff}.demo-tab.active{background:#164054;border-color:#3b7b89;color:#83f2ed}.demo-sidefoot{margin-top:auto;color:#8ba6b8;font-size:.7rem}.demo-main{min-width:0}.demo-toolbar{padding:16px 24px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #29455b;color:#9bb6c8;font-size:.8rem}.demo-avatar{border-radius:50%;background:#2b6170;color:#fff;padding:9px;font-size:.7rem;font-weight:800}.demo-view{padding:28px}.demo-heading{display:flex;justify-content:space-between;align-items:center;gap:12px}.demo-heading h3{font-size:clamp(1.35rem,2.5vw,2rem);margin:10px 0 22px;letter-spacing:-.04em}.demo-pill{font-size:.7rem;border:1px solid #375b6b;border-radius:100px;padding:8px 10px;color:#a9d9d7;white-space:nowrap}.demo-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}.demo-metrics>div{padding:18px;border:1px solid #2d4c61;border-radius:12px;background:#10283a}.demo-metrics small{display:block;color:#9cb7c7}.demo-metrics strong{display:block;font-size:1.6rem;margin-top:9px}.demo-tablewrap{overflow-x:auto;border:1px solid #2b465a;border-radius:12px}.demo-table{width:100%;border-collapse:collapse;text-align:left;min-width:460px}.demo-table th,.demo-table td{padding:15px;border-bottom:1px solid #263e50;font-size:.86rem}.demo-table th{color:#9bb8c9;font-size:.73rem}.demo-table tbody tr:last-child td{border-bottom:0}.status{display:inline-block;border-radius:100px;padding:5px 9px;background:#1b4855;color:#9df2e9;font-size:.72rem}.demo-caption{padding:0 28px 23px;color:#87a5b9;font-size:.73rem}.faq-list{max-width:900px}.faq-list details{border-bottom:1px solid #294458;padding:19px 2px}.faq-list summary{cursor:pointer;font-weight:750;font-size:1.08rem;list-style:none;display:flex;justify-content:space-between;gap:16px}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary:after{content:"+";color:#76e5e4;font-size:1.4rem}.faq-list details[open] summary:after{content:"−"}.faq-list p{color:#b4cad9;line-height:1.8;max-width:740px}.demo-tab:focus-visible,.faq-list summary:focus-visible{outline:3px solid #7ce5ff;outline-offset:3px}@media(max-width:760px){.demo-shell{grid-template-columns:1fr}.demo-side{border-right:0;border-bottom:1px solid #29465a;gap:12px;padding:18px}.demo-menu{display:flex;overflow-x:auto}.demo-tab{white-space:nowrap;flex:1;padding:11px 10px}.demo-sidefoot{display:none}.demo-view{padding:18px}.demo-toolbar{padding:13px 18px}.demo-caption{padding:0 18px 18px}.demo-heading{align-items:flex-start;flex-direction:column}.demo-metrics{gap:7px}.demo-metrics>div{padding:12px}.demo-metrics strong{font-size:1.3rem}}</style>
</head>
<body>
  <a class="skip" href="#main">Przejdź do treści</a>
  <header class="topbar"><nav class="nav container" aria-label="Nawigacja główna"><a class="logo" href="/" aria-label="Loop Control OS, strona główna">LOOP CONTROL <span>OS</span></a><div class="navlinks"><a href="#platforma">Platforma</a><a href="#demo">Demo</a><a href="#faq">FAQ</a><a class="navcta" href="#kontakt">Porozmawiajmy ↗</a></div></nav></header>
  <main id="main">
    <div class="hero container">
      <div><span class="eyebrow">Jedna platforma. Więcej kontroli.</span><h1>Oszczędzaj czas.<br /><strong>Panuj nad biznesem.</strong></h1><p class="lead">Mniej chaosu w zadaniach, mniej przełączania między narzędziami. Klienci, leady, sprzedaż i marketing w jednym miejscu — żeby odzyskać czas na to, co naprawdę rozwija firmę.</p><div class="actions"><a class="button primary" href="/demo/">Uruchom demo aplikacji ↗</a><a class="button secondary" href="#kontakt">Zapytaj o prezentację</a></div><p class="note">Modułowe narzędzie rozwijane z myślą o małych i średnich firmach.</p></div>
      <div class="preview" role="img" aria-label="Poglądowa wizualizacja panelu z kartami i wykresem; nie są to rzeczywiste dane klientów"><div class="previewbar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><small>LOOP CONTROL OS / OVERVIEW</small></div><div class="dashboard"><div class="dashlabel">Twoja przestrzeń pracy</div><div class="dashtitle">Wszystko w jednym widoku</div><div class="stats"><div class="stat"><small>Relacje</small><b>CRM</b></div><div class="stat"><small>Proces</small><b>Sales</b></div><div class="stat"><small>Pozyskiwanie</small><b>Leads</b></div><div class="stat"><small>Komunikacja</small><b>Content</b></div></div><div class="bars" aria-hidden="true"><span style="--h:35%"></span><span style="--h:58%"></span><span style="--h:48%"></span><span style="--h:77%"></span><span style="--h:65%"></span><span style="--h:92%"></span><span style="--h:80%"></span></div><div class="previewcaption">Wizualizacja koncepcyjna · bez danych rzeczywistych</div></div></div>
    </div>
    <section class="section container" id="platforma" aria-labelledby="platforma-title"><div class="sectiontop"><div class="kicker">Ekosystem Loop Control OS</div><h2 id="platforma-title">Narzędzia, które pracują razem.</h2><p class="sectionintro">Zamiast rozpraszać informacje pomiędzy wieloma aplikacjami, buduj uporządkowany proces: od znalezienia kontaktu po obsługę relacji i komunikację.</p></div><div class="grid">{modules.map((module) => <article class="module"><div class="modulehead"><span>{module.tag}</span><span>{module.number}</span></div><h3>{module.title}</h3><p>{module.description}</p><ul>{module.points.map((point) => <li>{point}</li>)}</ul></article>)}</div></section>
<section class="section container" id="demo" aria-labelledby="demo-title"><div class="sectiontop"><div class="kicker">Prawdziwy układ aplikacji</div><h2 id="demo-title">Wejdź do środka Loop Control OS.</h2><p class="sectionintro">Otwórz osobną przestrzeń demonstracyjną wzorowaną na strukturze naszej aplikacji: panel główny, CRM, Lead Intelligence, Sales Pipeline, AI Analyzer i Content Engine. Przełączaj moduły i filtruj przykładowe rekordy. Bez logowania, bez ryzyka, bez prawdziwych danych klientów.</p><div class="actions"><a class="button primary" href="/demo/">Uruchom pełnoekranowe demo ↗</a></div></div></section><section class="section container" id="korzysci" aria-labelledby="benefits-title"><div class="sectiontop"><div class="kicker">Mniej tarcia. Więcej działania.</div><h2 id="benefits-title">Zobacz szerszy obraz swojej firmy.</h2><p class="sectionintro">Jedna przestrzeń pracy ułatwia zachowanie ciągłości działań i porządek w informacjach, bez obietnic magicznych wyników.</p></div><div class="benefits"><div class="benefit"><b>Jasne priorytety</b><p>Wiesz, do kogo wrócić i jakie zadanie wykonać w następnej kolejności.</p></div><div class="benefit"><b>Spójne procesy</b><p>Połącz pracę z klientami, sprzedaż i komunikację w logiczny przepływ.</p></div><div class="benefit"><b>Przestrzeń na rozwój</b><p>Korzystaj z modułów dopasowanych do potrzeb i etapu rozwoju firmy.</p></div></div></section>
<section class="section container" id="faq" aria-labelledby="faq-title"><div class="sectiontop"><div class="kicker">Najczęstsze pytania</div><h2 id="faq-title">Wszystko jasne, zanim zaczniemy.</h2></div><div class="faq-list"><details><summary>Czym jest Loop Control OS?</summary><p>To rozwijana platforma łącząca pracę z klientami, leadami, sprzedażą i marketingiem w jednym środowisku.</p></details><details><summary>Dla kogo powstaje platforma?</summary><p>Przede wszystkim dla małych i średnich firm, które chcą uporządkować kontakty, zadania i proces sprzedażowy.</p></details><details><summary>Czy demo pokazuje prawdziwe dane?</summary><p>Nie. Interaktywna prezentacja jest symulacją interfejsu opartą na fikcyjnych danych. Nie łączy się z prywatnymi danymi klientów.</p></details><details><summary>Czy system jest już dostępny dla wszystkich?</summary><p>Produkt jest nadal rozwijany. Aby poznać aktualną dostępność prezentacji lub wdrożenia, skontaktuj się z nami.</p></details><details><summary>Czy Loop Control OS zastępuje wszystkie narzędzia w firmie?</summary><p>Nie obiecujemy zastąpienia każdego narzędzia. Celem jest skupienie kluczowych procesów CRM, sprzedaży i komunikacji w jednym ekosystemie.</p></details><details><summary>Jak zapytać o prezentację?</summary><p>Skorzystaj z przycisku kontaktowego na stronie. Otworzy on wiadomość e-mail z gotowym tematem.</p></details></div></section><section class="cta container" id="kontakt" aria-labelledby="contact-title"><div class="kicker">Porozmawiajmy o Twojej firmie</div><h2 id="contact-title">Sprawdź, jak Loop Control OS może uporządkować Twój biznes.</h2><p>Produkt jest rozwijany. Skontaktuj się, aby zapytać o możliwości platformy i dostępność prezentacji.</p><div class="actions"><a class="button primary" href="mailto:kontakt@loopcontrolos.pl?subject=Prezentacja%20Loop%20Control%20OS">Zapytaj o prezentację ↗</a><a class="button secondary" href="#platforma">Wróć do modułów</a></div></section>
  </main>
  <footer class="footer"><div class="container footerinner"><span>© 2026 Loop Control OS · Platforma w rozwoju.</span><span><a href="mailto:kontakt@loopcontrolos.pl">kontakt@loopcontrolos.pl</a></span></div></footer>
</body>
</html>